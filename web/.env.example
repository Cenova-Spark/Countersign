# signet.addisdb.com — the relay's configuration.
#
# Copy to .env.local for local work, or set these in the Vercel project.
# Nothing here has a default that would let the relay run unauthenticated:
# a missing store or a missing auth key is an error, not a fallback.

# ── WorkOS AuthKit ───────────────────────────────────────────────────────
# Start in the Staging environment. Staging and Production have different
# client ids, so this pair has to change together with them.
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...

# Seals the session cookie. 32+ characters; anything shorter is refused rather
# than silently weakening the AES-256 seal.
#   openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Add this to WorkOS → Redirects:
#   https://signet.addisdb.com/api/auth/callback

# ── The relay store ──────────────────────────────────────────────────────
# Upstash Redis. Its native key expiry is the protocol's ttl_ms: a request
# nobody answered stops existing without anything having to sweep it.
# Vercel's Upstash integration sets KV_REST_API_* instead; both are accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────
# The site's own origin, for redirect URIs. Inferred from the request when
# unset, which is right everywhere except behind an unusual proxy.
# SIGNET_ORIGIN=https://signet.addisdb.com

# ── Local only ───────────────────────────────────────────────────────────
# Runs the relay out of process memory with no sign-in step. Two locks: this
# must be exactly "1", and the relay refuses it outright on a production
# deployment. Never set this in Vercel.
# SIGNET_DEV_RELAY=1
# SIGNET_DEV_USER=you@example.com
